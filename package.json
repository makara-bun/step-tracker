{
  "name": "step-tracker-assets",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i assets/app.css -o static/app.css --minify",
    "css:watch": "tailwindcss -i assets/app.css -o static/app.css --watch",
    "test": "node --test \"test/*.test.js\"",
    "start": "python3 -m http.server 8090 --bind 127.0.0.1 --directory docs",
    "web:css": "tailwindcss -i assets/web.css -o docs/app.css --minify",
    "web:css:watch": "tailwindcss -i assets/web.css -o docs/app.css --watch",
    "export-old-data": "node scripts/export-old-data.js"
  },
  "devDependencies": {
    "@fontsource-variable/grandstander": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@tailwindcss/cli": "^4.3.4",
    "htmx.org": "^2.0.11",
    "tailwindcss": "^4.3.4"
  },
  "type": "module"
}
